{
  "name": "haruhime.moe",
  "version": "0.3.0",
  "description": "haruhime's home page: osu! tools for players, mappers and tournament hosts, thanks, the brand kit, a showcase of @haruhimemoe/ui, contact and a disclaimer.",
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "homepage": "https://www.haruhime.moe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/haruhime.moe.git"
  },
  "bugs": {
    "url": "https://github.com/haruhimemoe/haruhime.moe/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "bun scripts/axe.ts",
    "test:watch": "vitest",
    "standards": "next-kit check",
    "repo-banners": "bun scripts/repo-banners.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@haruhimemoe/brand": "0.10.0",
    "@haruhimemoe/next-kit": "0.16.0",
    "@haruhimemoe/osu": "0.4.0",
    "@haruhimemoe/ui": "0.24.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.8",
    "better-auth": "1.7.5",
    "mongodb": "7.6.0",
    "mongoose": "9.10.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "lefthook": "2.1.14",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
