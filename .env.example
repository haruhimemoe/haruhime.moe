# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.
# Only /signin, /account and /api/* need these; every other page builds and runs without them.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The hub uses the "identity"
# database (users, osu! links, sessions) and builds its indexes on first connect, so its user needs readWrite on
# "identity". packs, pools and bb read the same database with read-only users.
MONGODB_URI=

# better-auth session secret, at least 32 characters. Generate one with: openssl rand -base64 32
# packs, pools and bb verify the session cookie with this same secret.
BETTER_AUTH_SECRET=

# Base URL better-auth builds its callback URLs from: https://www.haruhime.moe in production.
BETTER_AUTH_URL=http://localhost:3000

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an example)
# and secret. Set the app's callback URL to {BETTER_AUTH_URL}/api/auth/callback/osu, like
# https://www.haruhime.moe/api/auth/callback/osu (and http://localhost:3000/api/auth/callback/osu for a dev app).
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# Optional. The parent domain every auth cookie is scoped to, so packs, pools and bb see the session:
# .haruhime.moe in production. Leave it empty on localhost: the cookies then stay on this host.
HUB_COOKIE_DOMAIN=

# Optional. Discord account linking on /account: a Discord app's client ID and secret
# (https://discord.com/developers/applications). Add the redirect {BETTER_AUTH_URL}/api/account/discord/callback.
# Both empty turns the feature off: the routes answer 404 and /account hides the Discord row.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional. One secret per app for account export/delete fan-out and the inbox (openssl rand -base64 32). Each app
# sets the same value as its ACCOUNT_FANOUT_SECRET. While any is empty, "Delete my account" refuses and export
# leaves that app out.
ACCOUNT_SECRET_BB=
ACCOUNT_SECRET_PACKS=
ACCOUNT_SECRET_POOLS=
ACCOUNT_SECRET_TOURNEY=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
